# FinCast fine-tuning configuration
# Loaded by fine_tune.py via python-dotenv. Copy this to .env (same
# directory as fine_tune.py) and adjust as needed — no code changes required
# to point at a different base model, dataset location, or output path.

# Base model to fine-tune. Use the 4k-context variant — our examples are
# ~400-600 tokens, no need for the 128k variant (that's only for the
# separately-served Foundry Local inference model, a different artifact).
MODEL_ID=microsoft/Phi-3-mini-4k-instruct

# Dataset paths — output of combine_datasets.py
TRAIN_PATH="news_analysis\\news_scraper\\data\\train_data\\combined\\train.jsonl"
VAL_PATH="news_analysis\\news_scraper\\data\\train_data\\combined\\val.jsonl"

# Where the LoRA adapter checkpoints and final model get saved
ADAPTER_PATH="news_analysis\\fine_tune\\phi3-fincast-qlora-final"

PREDICTIONS_LOG_PATH = "predictions_log.jsonl"
