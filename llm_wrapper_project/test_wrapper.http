# Base host for the wrapper
@host =  http://127.0.0.1:5272

###
# Health check
GET {{host}}/health
Accept: application/json

###
# Chat completion (OpenAI-style endpoint)
POST {{host}}/v1/chat/completions
Content-Type: application/json
Accept: application/json

{
  "model": "Phi-3-mini-128k-instruct-cuda-gpu:1",
  "messages": [
    {
      "role": "user",
      "content": "Write a small poem about financial markets."
    }
  ],
  "temperature": 0,
  "max_tokens": 40,
  "extra_body": {
    "repetition_penalty": 5.0
  }
}

###
# Embeddings test
POST {{host}}/v1/embeddings
Content-Type: application/json
Accept: application/json

{
  "model": "Phi-3-mini-128k-instruct-cuda-gpu:1",
  "input": "test embedding"
}