# Base host for the wrapper
@host =  http://127.0.0.1:5271

###
# Health check
GET {{host}}/health
Accept: application/json

###
# Chat completion (OpenAI-style endpoint)
POST {{host}}/v1/chat/completions
Content-Type: application/json
Accept: application/json

{
  "model": "Phi-3-mini-128k-instruct-cuda-gpu:2",
  "messages": [
    {
      "role": "user",
      "content": "Write a small poem (4 sentences) about financial markets."
    }
  ],
  "temperature": 0.7,
  "max_tokens": 100,
  "extra_body": {
    "repetition_penalty": 5.0
  }
}

###
# Embeddings test
POST {{host}}/v1/embeddings
Content-Type: application/json
Accept: application/json

{
  "model": "Phi-3-mini-128k-instruct-cuda-gpu:2",
  "input": "test embedding"
}